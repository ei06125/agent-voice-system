#!/bin/bash
# Pre-commit: run tests for every project (dir with a pyproject.toml) that
# has a tests/ directory anywhere in the repo.
#
# Runs each project's tests via `uv run --with pytest pytest -q <tests_dir>`
# rather than executing test files directly. An earlier version ran each
# test_*.py directly with plain python3 - that silently no-ops on any file
# written pytest-only (no `if __name__ == "__main__":` runner, e.g.
# stt-local/tests/test_delivery_worker.py's asyncio-based tests), since
# nothing calls its test functions outside of pytest collection. Direct
# execution exits 0 having run zero tests, and the hook reported it as a
# pass. pytest correctly collects both that style and the plain-assert +
# __main__ style used elsewhere (see test_playback_gate.py) uniformly, so
# there's one code path instead of two silently-divergent ones.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# Secrets scan first, before spending time on tests - blocks the commit
# outright on any finding in the staged diff. Requires gitleaks on PATH;
# fails closed (aborts the commit) rather than silently skipping if it's
# missing, since a missing scanner is not the same as a clean scan.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found on PATH - install it (brew install gitleaks) - commit aborted"
  exit 1
fi
echo "pre-commit: running gitleaks on staged changes"
if ! gitleaks protect --source "$repo_root" --staged --redact -v; then
  echo "pre-commit: gitleaks found a potential secret - commit aborted"
  exit 1
fi

status=0
ran_any=0

while IFS= read -r -d '' tests_dir; do
  proj_dir="$(dirname "$tests_dir")"
  if [[ ! -f "$proj_dir/pyproject.toml" ]]; then
    continue
  fi
  ran_any=1
  echo "pre-commit: running pytest in $proj_dir"
  if ! (cd "$proj_dir" && uv run --with pytest pytest -q tests); then
    echo "pre-commit: FAILED $proj_dir"
    status=1
  fi
done < <(find "$repo_root" -type d -name 'tests' \
  -not -path '*/.venv/*' -not -path '*/node_modules/*' -print0)

if [[ "$ran_any" -eq 0 ]]; then
  echo "pre-commit: no tests found, nothing to run"
fi

if [[ $status -ne 0 ]]; then
  echo "pre-commit: one or more tests failed - commit aborted"
  exit 1
fi

exit 0
