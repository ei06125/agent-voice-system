{
  "mcpServers": {
    "stt-local": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "/absolute/path/to/DONNA",
        "python",
        "-m",
        "donna.tools.stt_mcp_server"
      ],
      "env": {}
    },
    "kokoro-local": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "/absolute/path/to/DONNA",
        "python",
        "-m",
        "donna.text_to_speech.kokoro_mcp_server"
      ],
      "env": {}
    }
  }
}
